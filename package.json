{
  "name": "tpb-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TPB UNU Purwokerto \u2014 monorepo (web, api, contracts, migration tooling)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @tpb/web dev",
    "dev:api": "pnpm --filter @tpb/api dev",
    "dev:api:dist": "pnpm --filter @tpb/api build && node apps/api/dist/main.js",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./start.ps1",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File ./stop.ps1",
    "dev:db": "docker compose up -d db",
    "prisma:generate": "pnpm --filter @tpb/api prisma:generate",
    "db:migrate": "pnpm --filter @tpb/api prisma:migrate",
    "db:migrate:create": "pnpm --filter @tpb/api prisma:migrate --name",
    "db:migrate:deploy": "pnpm --filter @tpb/api prisma:deploy",
    "api:preflight": "pnpm --filter @tpb/api build && node -e \"require('./apps/api/dist/config.js')\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @tpb/api test",
    "migration:export": "pnpm --filter @tpb/supabase-migration export",
    "migration:import": "pnpm --filter @tpb/supabase-migration import",
    "migration:reconcile": "pnpm --filter @tpb/supabase-migration reconcile",
    "content:migrate": "pnpm --filter @tpb/content-migration migrate",
    "content:migrate:write": "pnpm --filter @tpb/content-migration write",
    "content:migrate:reconcile": "pnpm --filter @tpb/content-migration reconcile",
    "content:drop-legacy": "pnpm --filter @tpb/content-migration drop-legacy",
    "lint": "eslint .",
    "audit:env": "pnpm --filter @tpb/env-audit check",
    "check:fast": "pnpm -r typecheck && pnpm lint",
    "check:task": "pnpm check:fast && pnpm --filter @tpb/api test -- --coverage --ci && pnpm --filter @tpb/web test -- --coverage",
    "check:full": "pnpm check:task && pnpm audit:env && semgrep scan --config p/default --config p/owasp-top-ten apps packages tools --quiet && osv-scanner scan source -r ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.19.0"
  }
}
