// TPB API — Prisma schema (MySQL 8.0)
// Dev: npx prisma migrate dev --name init | CI/server: prisma migrate deploy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  OPERATOR
}

enum PostStatus {
  published
  draft
}

enum PmbStatus {
  baru
  diproses
  diterima
  ditolak
}

enum PageStatus {
  draft
  published
}

// ---------------------------------------------------------------- users/auth

model User {
  id           String    @id @default(uuid())
  email        String    @unique @db.VarChar(320)
  name         String?   @db.VarChar(160)
  passwordHash String    @db.VarChar(255)
  role         Role      @default(OPERATOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  posts         Post[]

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid())
  tokenHash    String    @unique @db.VarChar(64)
  userId       String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// -------------------------------------------------------------------- posts

model Post {
  id        String     @id @default(uuid())
  slug      String     @unique @db.VarChar(220)
  title     String     @db.VarChar(220)
  category  String     @db.VarChar(80)
  excerpt   String?    @db.VarChar(2000)
  content   String?    @db.Text
  image     String?    @db.VarChar(2000)
  readTime  String?    @db.VarChar(40)
  status    PostStatus @default(draft)
  date      DateTime   @db.DateTime(3)
  authorId  String?
  author    User?      @relation(fields: [authorId], references: [id])
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, date])
  @@map("posts")
}

// ---------------------------------------------------------------------- pmb

model PmbRegistration {
  id             String    @id @default(uuid())
  idempotencyKey String    @unique @db.VarChar(64)
  name           String    @db.VarChar(160)
  email          String    @db.VarChar(320)
  phone          String    @db.VarChar(40)
  school         String?   @db.VarChar(160)
  program        String?   @db.VarChar(120)
  message        String?   @db.Text
  status         PmbStatus @default(baru)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("pmb_registrations")
}

// ------------------------------------------------------------------ gallery

model GalleryItem {
  id        String   @id @default(uuid())
  image     String   @db.VarChar(2000)
  imageHash String   @unique @db.VarChar(64)
  caption   String?  @db.VarChar(500)
  link      String?  @db.VarChar(2000)
  kind      String   @default("image") @db.VarChar(20)
  title     String?  @db.VarChar(300)
  category  String?  @db.VarChar(160)
  thumb     String?  @db.VarChar(2000)
  createdAt DateTime @default(now())

  @@map("gallery_items")
}

// -------------------------------------------------------------- subscribers

model Subscriber {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(320)
  subscribedAt DateTime @default(now())

  @@map("subscribers")
}

// -------------------------------------------------------------------- stats

model SiteStat {
  id     String @id @default(uuid())
  value  Int
  suffix String @db.VarChar(20)
  label  String @db.VarChar(160)
  ord    Int    @default(0)

  @@map("site_stats")
}

// ------------------------------------------------------------- site content
// DEPRECATED (legacy): tabel ini masih dibuat oleh migration agar riwayat skema konsisten,
// tetapi sudah TIDAK dipakai runtime — halaman+blok menggantikannya (lihat model Page/Block).
// Hapus tabelnya di server dengan `pnpm content:drop-legacy -- --yes` setelah migrasi konten.
model SiteContent {
  key       String    @id @db.VarChar(64)
  data      Json?
  updatedAt DateTime  @updatedAt
  updatedBy String?

  @@map("site_content")
}

// Modular content — tiap top-level key SiteContent jadi baris sendiri (100% modular admin).
// key: brand | navigation | hero | marquee | stats | about | programs | research | community | studentLife | profil | akademik | penelitian | pengabdian | kemahasiswaan | news | cta | footer | pmbLink
model SiteModule {
  key       String    @id @db.VarChar(64)
  data      Json
  updatedAt DateTime  @updatedAt
  updatedBy String?

  @@map("site_modules")
}

// -------------------------------------------------------------------- media

model MediaAsset {
  id        String   @id @default(uuid())
  url       String   @db.VarChar(2000)
  filename  String   @db.VarChar(255)
  mimeType  String   @db.VarChar(120)
  size      Int
  alt       String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  @@map("media_assets")
}

// -------------------------------------------------------------------- audit

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(80)
  entityId  String?  @db.VarChar(64)
  metadata  Json?
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------- page builder

// Halaman situs: satu baris per halaman; blok disimpan terpisah di `blocks`.
model Page {
  id             String     @id @default(uuid())
  slug           String     @unique @db.VarChar(160)
  title          String     @db.VarChar(220)
  status         PageStatus @default(draft)
  seoTitle       String?    @db.VarChar(220)
  seoDescription String?    @db.VarChar(500)
  ogImage        String?    @db.VarChar(2000)
  publishedAt    DateTime?
  publishedData  Json?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  blocks         Block[]
  revisions      PageRevision[]

  @@index([status, updatedAt])
  @@map("pages")
}

// Blok konten per halaman; `data` divalidasi Zod per `type` di kontrak.
model Block {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(40)
  position  Int
  data      Json
  isVisible Boolean  @default(true)
  anchor    String?  @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, position])
  @@map("blocks")
}

// Snapshot halaman + blok saat terbit (undo/riwayat).
model PageRevision {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  data      Json
  createdBy String?
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
  @@map("page_revisions")
}

// Menu navigasi global (multi-level via parentId).
model NavItem {
  id           String    @id @default(uuid())
  parentId     String?
  parent       NavItem?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavItem[] @relation("NavChildren")
  label        String    @db.VarChar(160)
  href         String    @db.VarChar(2000)
  openInNewTab Boolean   @default(false)
  position     Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([parentId, position])
  @@map("nav_items")
}

// Pengaturan global situs (brand, footer, link PMB) — key unik.
model SiteSetting {
  key       String   @id @db.VarChar(64)
  data      Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}