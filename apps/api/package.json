{
  "name": "@tpb/api",
  "version": "1.0.0",
  "private": true,
  "description": "TPB UNU Purwokerto - NestJS API (Prisma + MySQL 8.0), prefix /v1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "6.19.3",
    "@tpb/contracts": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "multer": "^2.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/sanitize-html": "^2.16.1",
    "jest": "^29.7.0",
    "prisma": "^6.2.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testRegex": ".spec.ts$",
    "moduleNameMapper": {
      "^@tpb/contracts$": "<rootDir>/../../packages/contracts/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": ["ts-jest", {}],
      "^.+\\.js$": ["ts-jest", { "tsconfig": { "allowJs": true, "module": "commonjs", "target": "es2022", "esModuleInterop": true, "skipLibCheck": true }, "diagnostics": false }]
    },
    "transformIgnorePatterns": [
      "node_modules/.pnpm/(?!(htmlparser2|domhandler|domelementtype|domutils|dom-serializer|entities)@)"
    ]
  }
}
